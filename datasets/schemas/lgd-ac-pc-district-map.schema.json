{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./lgd-ac-pc-district-map.schema.json",
  "title": "LGD AC -> district coverage map",
  "description": "Per-AC district coverage edges from the LGD Constituency Coverage Report. An AC can span multiple districts. FK both sides to lgd_acs.json and lgd_districts.json.",
  "x-version": "1.0",
  "type": "object",
  "required": ["$schema", "$schema_version", "sources", "rows"],
  "additionalProperties": true,
  "properties": {
    "$schema": {"type": "string"},
    "$schema_version": {"type": "string"},
    "$comment": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lgd_state_id", "lgd_ac_id", "lgd_district_ids"],
        "additionalProperties": false,
        "properties": {
          "lgd_state_id": {"type": "integer", "minimum": 1, "maximum": 99},
          "lgd_ac_id": {"type": "integer", "minimum": 1},
          "lgd_district_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
