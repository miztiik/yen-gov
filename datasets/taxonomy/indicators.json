      "indicator_id": "state-installed-capacity-geographical-mw",
      "label_short": "Capacity sited in state",
      "label_long": "State installed electricity capacity, geographical-location basis (MW)",
      "description_short": "Total installed capacity physically located in the state, summed across all fuels. 'Geographical' means every plant counts toward the state where it sits, regardless of who owns it or where the power is dispatched.",
      "description_long": "Read this as 'where the steel-and-concrete sits' — NOT 'where the electricity flows to'. For the share-allocated counterpart (rights to output via central-sector PPAs), see state-installed-capacity-allocated-mw. The all-India total equals the allocated total (as it must) but the per-state breakdown diverges sharply for states that import or export power through central PPAs. Compute-on-read parent: sums the five atomic-fuel children.",
      "unit": "MW",
      "cadence": "annual_fy",
      "family": "energy",
      "pillar": "infrastructure",
      "value_kind": "absolute",
      "direction": "neutral",
      "attribution_geography": "where_produced",
