      "comparability": "comparable_across_states_and_time",
      "implementing_authority": "joint",
      "methodology_vintage": "RBI Handbook of Statistics on Indian States 2024-25 edition, Table 142 (Peak Met column). Originating data: Central Electricity Authority.",
      "revision_tier": "final",
      "parent_indicator_id": null,
      "source_id": "src-9c02616a7166"
