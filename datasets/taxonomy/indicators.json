    {
      "indicator_id": "national-installed-capacity-mw",
      "label_short": "All-India installed capacity",
      "label_long": "All-India installed electricity-generation capacity (MW)",
      "description_short": "Total nameplate generating capacity in megawatts, summed across all fuels, for India. Snapshot end-of-month from the CEA Monthly Executive Summary.",
      "description_long": "Nameplate capacity is the maximum sustained output a plant can deliver under ideal conditions — NOT the energy it actually produced. A state with high capacity isn't necessarily a high-generation state if those plants run at low plant-load factor (PLF). Compute-on-read parent: the value is the sum of the five atomic-fuel children (coal + gas + hydro + nuclear + renewable). No `_total_mw` row exists on disk (ADR-0030 D33.8 refusal).",
      "unit": "MW",
      "cadence": "monthly_cy",
      "family": "energy",
      "pillar": "infrastructure",
      "value_kind": "absolute",
      "direction": "neutral",
      "attribution_geography": "where_produced",
      "comparability": "comparable_across_states_and_time",
      "implementing_authority": "joint",
      "methodology_vintage": "CEA Monthly Executive Summary — Installed Capacity (IC) sheet; snapshot reported month-end. Sub-fuel taxonomy stable through current vintage; coal+lignite combined per CEA convention.",
      "revision_tier": "first_release",
      "parent_indicator_id": null,
      "source_id": "src-092a5dc7af3f"
    },
