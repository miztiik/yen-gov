      "indicator_id": "state-peak-electricity-demand-mw",
      "label_short": "Peak demand",
      "label_long": "State-wise peak power demand (MW)",
      "description_short": "Highest single-instant electricity demand observed in the state during the fiscal year (MW). 'Peak' is system-wide simultaneous demand recorded by the State Load Despatch Centre — typically a summer afternoon (north / west) or winter evening (Punjab, Delhi).",
      "description_long": "Read alongside Peak Met (state-peak-electricity-supplied-mw) — the gap is the unmet peak demand, more operationally critical than the energy-deficit % because shortages force load-shedding. RBI Handbook relabelled 'Surplus / Deficit' to 'Demand Not Met' from FY 2019-20 onwards; underlying definition is unchanged.",
      "unit": "MW",
      "cadence": "annual_fy",
      "family": "energy",
      "pillar": "infrastructure",
      "value_kind": "absolute",
