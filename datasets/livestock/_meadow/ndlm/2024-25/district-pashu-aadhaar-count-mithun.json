  "indicator": {
    "id": "livestock/pashu_aadhaar_count_mithun",
    "title": "Pashu Aadhaar tagged - Mithun",
    "description": "Number of mithun tagged with Pashu Aadhaar (NDLM) in each district. Pashu Aadhaar is the UIDAI-style 12-digit tag issued by the National Digital Livestock Mission to individual animals; the count here is a count of tags issued, NOT an estimate of the actual mithun population of the district. Coverage varies by state as the rollout is in progress.",
    "entity_kind": "district",
    "time_grain": "fiscal_year",
    "value_kind": "raw",
    "direction": "neutral",
    "scale_hint": "linear",
    "unit": "animals",
    "short_unit": "head",
    "attribution_geography": "where_resident",
    "comparability": "directional_only",
    "implementing_authority": "centre",
    "methodology_vintage": "NDLM Bharat Pashudhan; raw vintages ['2024-25']; snapshot 2026-05-25T13:43:41Z",
    "notes": "Hans honest-renderer: tagged count is NOT a livestock-population estimate. Indicator carries renderer_rules=[no_rank_table] in the canonical catalogue. Animals without a recorded total are skipped (NDLM may emit null totals for species with only male xor female counts present). Each row's `time` is the raw NDLM vintage selector (`2024` for CY 2024, `2024-25` for FY 2024-25); the canonical adapter decodes this to (period_label, year, period_seq)."
  },
